# Google Gemini (required for photo → 3D). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Backups, tried in order when the main model is overloaded (503), out of quota (429) or too slow.
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# YouTube Data API v3 key (optional, free). Shows real matching YouTube lessons inside the app.
# Without it the app shows a "search on YouTube" button instead.
# Google Cloud Console → create project → enable "YouTube Data API v3" → Credentials → Create API key.
YOUTUBE_API_KEY=

# Hosting (Embarko sets PORT itself). DATA_DIR stores shared models.
# PORT=8787
# DATA_DIR=/data
# PUBLIC_APP_URL=https://your-name.embarko.app
