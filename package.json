{
  "name": "popup-science",
  "version": "1.0.0",
  "private": true,
  "description": "Photograph a textbook science diagram and see it pop up as an interactive 3D model, explained step by step, with real YouTube lessons.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "hono": "4.13.14",
    "marked": "18.1.2",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "0.187.0",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
